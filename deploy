// ── CONTACT FORM ENDPOINT (site forms + missed-call calculator) ──
app.post('/contact-form', async (req, res) => {
  try {
    const { name, email, phone, businessName, message } = req.body;
    if (!name || !email || !phone) {
      return res.status(400).json({ error: 'Name, email, and phone are required' });
    }

    // Keep the historical leads.json log (async + serialized now).
    await store.updateJson('leads.json', [], (leads) => {
      leads.push({
        id: Date.now().toString(),
        name, email, phone,
        businessName: businessName || '',
        message: message || '',
        source: 'contact-form',
        status: 'new',
        createdAt: new Date().toISOString()
      });
    });

    // CRM system of record + dashboard mirror in one call.
    await crm.upsertLead(DEFAULT_CLIENT_SLUG, {
      name, email, phone,
      message,
      note: message ? String(message).slice(0, 300) : undefined,
      stage: 'New Lead',
      source: 'contact-form',
      tags: ['web-form'],
    });

    // Owner alert — ledger-aware, env-credentialed, no hardcoded numbers.
    try {
      const profile = await profiles.loadProfile(DEFAULT_CLIENT_SLUG);
      const ownerCell = (profile && profile.identity && profile.identity.owner_cell) || process.env.OWNER_CELL;
      if (ownerCell) {
        await compliance.sendSms({
          to: ownerCell,
          body: `🔥 New Lead!\nName: ${name}\nBiz: ${businessName || 'N/A'}\nPhone: ${phone}\nEmail: ${email}\nMsg: ${(message || 'None').slice(0, 200)}`,
          profile: profile || {},
          mode: 'transactional',
        });
      } else {
        console.warn('[contact-form] no owner cell configured — lead saved, alert skipped');
      }
    } catch (e) {
      console.error('Owner alert error:', e.message);
    }

    res.json({ success: true });
  } catch (e) {
    console.error('[contact-form]', e);
    res.status(500).json({ error: 'internal error' });
  }
});

// ── AI CHAT (merged: website-builder proxy + NewSites sales assistant) ──
