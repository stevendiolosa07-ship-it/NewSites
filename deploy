    if (!clientId || !name || !services || !phone || !address) {
      return res.status(400).json({ error: 'Missing required fields' });
    }
    const { generateWebsite } = require('./website-generator');
    const outputPath = await generateWebsite(clientId, { name, services, phone, address, email, colors });
    res.json({ success: true, path: outputPath, url: `/sites/${clientId}` });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

// ── AI chat API for client websites (Gemini) ──
app.post('/api/chat', async (req, res) => {
  try {
    const { message } = req.body;
    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${process.env.GEMINI_API_KEY}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ contents: [{ parts: [{ text: message }] }], generationConfig: { maxOutputTokens: 256 } })
    });
    const data = await response.json();
    const reply = data.candidates?.[0]?.content?.parts?.[0]?.text || 'Sorry, I could not get a response.';
    res.json({ reply });
  } catch (e) {
    res.status(500).json({ reply: 'Sorry, I am unavailable right now.' });
  }
});

// ============================================
// SOCIAL POST APPROVAL WORKFLOW
// ============================================
const PENDING_POSTS = 'pending-posts.json'; // resolved under DATA_ROOT (/root/newsites-sms)

// AI submits a pending post for approval
app.post('/pending-post', async (req, res) => {
