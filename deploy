'use strict';

// CRM adapter — the ONE file that knows where and how leads are stored.
//
// TWO stores, written together:
//
// 1. SYSTEM OF RECORD (automation): {DATA_ROOT}/clients/{slug}/crm.json
//    { "leads": { "+13235550142": { name, phone, email, stage, tags, source,
//                                   created_at, updated_at, last_activity_at,
//                                   history: [...] } } }
//    Stages, history, and last-activity feed the jobs engine (follow-up
//    skip logic, review + reactivation hooks).
//
// 2. LEGACY DASHBOARD MIRROR: {DATA_ROOT}/crm.json  (= /root/newsites-sms/crm.json)
//    The flat ARRAY read by the live crm.js dashboard (port 3003) and by
//    index.js. Every upsert/stage-move is mirrored there so new leads are
//    VISIBLE in the dashboard Steve actually looks at. Shape per existing
//    records: { id, createdAt, name, phone, email, need, status, score,
//    source, businessName }. Matching is by last-10 phone digits (the file
//    contains " 13105551234" and "3105551234" style variants) or email.
//    Existing records are updated conservatively — id/createdAt/phone
//    formatting are never touched.
//
//    Disable with LEGACY_CRM_MIRROR=0. Override path with LEGACY_CRM_FILE.
//
// HONEST LIMIT — cross-process races: crm.js and index.js do synchronous
// read-modify-writes on the legacy file from their own processes. Our writes
// are serialized in-process and atomic on disk (temp+rename, never a torn
// file), but a simultaneous sync write from crm.js can still lose one
// update either way. That race predates this module (crm.js vs index.js
// already share the file). Window is milliseconds; real fix is the Phase-2
// single-writer/SQLite move. Mirror failures are logged and never break the
// primary write.
//
// Stage hooks (STEP 3.2): moving a lead into the profile's review trigger
// stage (default "Job Done") schedules review_request (+N h) and
// reactivation_check (+90 d) via jobs-engine (lazy-required to avoid a
// circular require at load).

const store = require('./lib/store');
const phone = require('./lib/phone');

const HISTORY_CAP = 50;
const LEGACY_FILE = process.env.LEGACY_CRM_FILE || 'crm.json';
const MIRROR_ON = process.env.LEGACY_CRM_MIRROR !== '0';

function crmPath(slug) {
  return `clients/${slug}/crm.json`;
}

function emptyCrm() {
  return { leads: {} };
}

function nowIso() {
  return new Date().toISOString();
}

function pushHistory(lead, entry) {
  lead.history = lead.history || [];
  lead.history.push({ at: nowIso(), ...entry });
  if (lead.history.length > HISTORY_CAP) {
    lead.history = lead.history.slice(-HISTORY_CAP);
  }
}

// ---------------------------------------------------------------------------
// Legacy dashboard mirror
// ---------------------------------------------------------------------------

const SOURCE_LABELS = {
  missed_call: 'Missed Call',
  web_form: 'Website Form',
  sms: 'Twilio SMS',
  voice: 'Phone Call',
};

function findLegacyIndex(list, e164, email) {
  const key10 = e164 ? phone.last10(e164) : null;
  const mail = email ? String(email).trim().toLowerCase() : null;
  return list.findIndex((c) => {
    if (!c || typeof c !== 'object') return false;
    if (key10 && c.phone && phone.last10(c.phone) === key10) return true;
    if (mail && c.email && String(c.email).trim().toLowerCase() === mail) return true;
    return false;
  });
}

// Mirror an upsert/stage change into the flat dashboard array. Best-effort:
// never throws into the caller.
async function mirrorLegacy(slug, { e164, email, name, note, stage, score, source }) {
  if (!MIRROR_ON) return;
  try {
    let businessName = null;
    try {
      const profiles = require('./lib/profiles'); // lazy — adapter must load standalone
      const profile = await profiles.loadProfile(slug);
      businessName = (profile && profile.identity && profile.identity.business_name) || null;
    } catch (_) { /* profile missing — mirror without businessName */ }

    await store.updateJson(LEGACY_FILE, [], (list) => {
      if (!Array.isArray(list)) list = []; // corrupt/foreign shape — start clean (store preserved the original)
      const i = findLegacyIndex(list, e164, email);
      if (i >= 0) {
        const c = list[i];
        if (name && (!c.name || /^(sms lead|new lead|missed call)$/i.test(c.name))) c.name = name;
        if (email && !c.email) c.email = email;
        if (stage) c.status = stage;
        if (note && !c.need) c.need = String(note).slice(0, 300);
        if (Number.isFinite(score)) c.score = score;
        if (businessName && !c.businessName) c.businessName = businessName;
      } else {
        const PLACEHOLDER = { missed_call: 'Missed Call Lead', sms: 'SMS Lead', voice: 'Phone Lead', web_form: 'Website Lead' };
        const rec = {
          id: Date.now(),
          createdAt: nowIso(),
          name: name || (PLACEHOLDER[source] || 'New Lead'),
          phone: e164 || '',
          email: email || '',
          need: note ? String(note).slice(0, 300) : '',
          status: stage || 'New Lead',
          source: SOURCE_LABELS[source] || source || 'automation',
        };
        if (Number.isFinite(score)) rec.score = score;
        if (businessName) rec.businessName = businessName;
        list.push(rec);
      }
      return list;
    });
  } catch (err) {
    console.warn(`[crm] legacy mirror failed (${slug}): ${err.message}`);
  }
}

// ---------------------------------------------------------------------------
// System of record
// ---------------------------------------------------------------------------

// Create or update a lead keyed by E.164 phone. Email-only leads are keyed by
// "email:{address}". Returns the stored lead (or null if unkeyable).
async function upsertLead(slug, data) {
  const e164 = phone.toE164(data.phone);
  const key = e164 || (data.email ? `email:${String(data.email).trim().toLowerCase()}` : null);
  if (!key) return null;

  let saved = null;
  let createdOrStaged = false;
  await store.updateJson(crmPath(slug), emptyCrm, (crm) => {
    crm.leads = crm.leads || {};
    const existing = crm.leads[key];
    if (existing) {
      if (data.name && !existing.name) existing.name = data.name;
      if (data.email && !existing.email) existing.email = data.email;
      if (e164 && !existing.phone) existing.phone = e164;
      if (data.tags && data.tags.length) {
        existing.tags = Array.from(new Set([...(existing.tags || []), ...data.tags]));
      }
      existing.updated_at = nowIso();
      existing.last_activity_at = nowIso();
      pushHistory(existing, { type: 'touch', source: data.source || 'unknown', note: data.note });
      saved = existing;
    } else {
      const lead = {
        name: data.name || null,
        phone: e164 || null,
        email: data.email || null,
        stage: data.stage || 'New Lead',
        tags: data.tags || [],
        source: data.source || 'unknown',
        created_at: nowIso(),
        updated_at: nowIso(),
        last_activity_at: nowIso(),
        history: [],
      };
      pushHistory(lead, { type: 'created', source: lead.source, note: data.note });
      crm.leads[key] = lead;
      saved = lead;
      createdOrStaged = true;
    }
  });

  await mirrorLegacy(slug, {
    e164,
    email: data.email,
    name: data.name,
    note: data.note || data.message,
    stage: createdOrStaged ? (saved && saved.stage) : null, // don't stomp dashboard status on mere touches
    score: data.score,
    source: data.source,
  });
  return saved;
}

async function getLead(slug, rawPhone) {
  const e164 = phone.toE164(rawPhone);
  if (!e164) return null;
  const crm = await store.readJson(crmPath(slug), emptyCrm());
  return (crm.leads && crm.leads[e164]) || null;
}

// Record inbound activity (call, sms reply, form) without changing stage.
// Feeds the "skip follow-up / reactivation if they already responded" logic.
async function touchActivity(slug, rawPhone, meta) {
  const e164 = phone.toE164(rawPhone);
  if (!e164) return null;
  let found = false;
  await store.updateJson(crmPath(slug), emptyCrm, (crm) => {
    const lead = crm.leads && crm.leads[e164];
    if (!lead) return;
    found = true;
    lead.last_activity_at = nowIso();
    lead.updated_at = nowIso();
    pushHistory(lead, { type: 'activity', ...(meta || {}) });
  });
  return found; // no legacy mirror: nothing dashboard-visible changed
}

async function moveStage(slug, rawPhone, stage, meta) {
  const e164 = phone.toE164(rawPhone);
  if (!e164) return null;

  let moved = null;
  await store.updateJson(crmPath(slug), emptyCrm, (crm) => {
    const lead = crm.leads && crm.leads[e164];
    if (!lead) return;
    const fromStage = lead.stage;
    lead.stage = stage;
    lead.updated_at = nowIso();
    pushHistory(lead, { type: 'stage', from: fromStage, to: stage, ...(meta || {}) });
    moved = { lead, fromStage };
  });
  if (!moved) return null;

  await mirrorLegacy(slug, {
    e164,
    email: moved.lead.email,
    name: moved.lead.name,
    stage, // dashboard "status" tracks the automation stage
  });

  await runStageHooks(slug, e164, stage);
  return moved.lead;
}

async function runStageHooks(slug, e164, stage) {
  const profiles = require('./lib/profiles');
  const jobs = require('./jobs-engine'); // lazy: avoids circular require at load

  const profile = await profiles.loadProfile(slug);
  if (!profile) return;

  const rep = profile.reputation || {};
  const triggerStage = rep.trigger_stage || 'Job Done';
  if (stage !== triggerStage) return;

  const delayHours = Number.isFinite(rep.delay_hours) ? rep.delay_hours : 4;
  if (rep.google_review_url) {
    await jobs.schedule({
      client_slug: slug,
      action: 'review_request',
      payload: { phone: e164 },
      due_at: Date.now() + delayHours * 60 * 60 * 1000,
      dedupe_key: `review:${slug}:${e164}`,
    });
  } else {
    console.warn(`[crm] ${slug}: stage "${triggerStage}" reached but reputation.google_review_url is not set — review request skipped`);
  }

  const reactDays = Number.isFinite(rep.reactivation_days) ? rep.reactivation_days : 90;
  await jobs.schedule({
    client_slug: slug,
