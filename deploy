#!/bin/bash
# NewSites one-shot deploy — 2026-08-22 overhaul.
# Everything is EMBEDDED in this file. No other downloads. Run it ON THE DROPLET:
#   bash deploy.sh
# Safe to re-run any number of times (idempotent). Makes timestamped backups.

set -uo pipefail
BASE="${NEWSITES_BASE:-/root/newsites-sms}"
CADDYFILE="${CADDYFILE:-/etc/caddy/Caddyfile}"
STAMP=$(date +%Y%m%d-%H%M%S)
FAIL=0
say()  { echo "==> $*"; }
ok()   { echo "  [OK] $*"; }
bad()  { echo "  [FAIL] $*"; FAIL=1; }
die()  { echo; echo "XX ABORTED: $*"; exit 1; }

[ -d "$BASE" ] || die "$BASE not found — this must run ON THE DROPLET (ssh root@164.92.110.116 first)"
cd "$BASE" || die "cannot cd $BASE"
export DATA_ROOT="$BASE"

say "1/8 Backups"
[ -f index.js ] && cp index.js "index.js.bak-$STAMP"
[ -f call-handler.js ] && cp call-handler.js "call-handler.js.bak-$STAMP"
[ -f crm-adapter.js ] && cp crm-adapter.js "crm-adapter.js.bak-$STAMP"
cp "$CADDYFILE" "$BASE/Caddyfile.bak-$STAMP" 2>/dev/null || true
ok "saved *.bak-$STAMP"

say "2/8 Writing the four overhaul files (embedded)"
cat > index.js << 'EOF_INDEXJS_7391'
// NewSites main server — index.js (v2, 2026-08-22 overhaul)
// Runs as PM2 process "newsites-sms" on port 3001.
//
// What changed vs v1 (rollback = restore index.js.bak-* and pm2 restart newsites-sms):
//   - SECURITY: hardcoded Twilio credentials removed. Everything reads .env.
//     Owner alerts go through compliance.sendSms (opt-out ledger aware).
//   - All request-path fs sync calls replaced with lib/store (atomic, serialized).
//   - /sms now runs STOP/HELP/START compliance first, then lead capture via
//     crm-adapter (which also mirrors into the dashboard's crm.json).
//   - Route dedupe: /onboarding is the Stripe checkout (was dead code at L444);
//     the old email-summary form moved to /onboarding-legacy. The two /ai-chat
//     handlers merged into one (caller-supplied system prompt wins, sales
//     persona is the default).
//   - New routers mounted: /twilio (missed-call status callback) and /leads
//     (speed-to-lead). Both parse their own bodies.
//   - app.listen moved to the actual end of the file.
//
// NOTE for future Stripe webhooks: if you add a signed webhook endpoint,
// register it with express.raw() ABOVE the global express.json() line below,
// or signature verification will fail.

const https = require('https');
const cors = require('cors');
require('dotenv').config({ path: '/root/newsites-sms/.env' });
const sgMail = require('@sendgrid/mail');
if (process.env.SENDGRID_API_KEY) {
  sgMail.setApiKey(process.env.SENDGRID_API_KEY);
} else {
  console.warn('[boot] SENDGRID_API_KEY missing — email sends will fail');
}
const express = require('express');
const fs = require('fs');
const fsp = fs.promises;

// Overhaul modules (lib/, routes/, compliance, crm-adapter live alongside this file)
const store = require('./lib/store');
const profiles = require('./lib/profiles');
const compliance = require('./compliance');
const crm = require('./crm-adapter');
const { xmlEscape } = require('./lib/tpl');
const { DEFAULT_CLIENT_SLUG } = require('./lib/constants');

const app = express();
app.use(cors({
  origin: 'https://stevendiolosa07-ship-it.github.io'
}));
app.use(express.urlencoded({ extended: false }));
app.use(express.json());

// New feature routers — self-parsing, mount before anything can shadow them.
app.use('/twilio', require('./routes/twilio-status')); // POST /twilio/status-callback (missed-call text-back)
app.use('/leads', require('./routes/leads'));          // POST /leads (speed-to-lead + scoring)

const smsTwiml = (msg) =>
  `<?xml version="1.0" encoding="UTF-8"?><Response>${msg ? `<Message>${xmlEscape(msg)}</Message>` : ''}</Response>`;

// ── INBOUND SMS (Twilio messaging webhook via Caddy /sms*) ──
app.post('/sms', async (req, res) => {
  res.type('text/xml');
  try {
    const from = req.body.From;
    const body = (req.body.Body || '').trim();
    console.log('SMS from ' + from + ': ' + body);

    const slug = await profiles.slugForNumber(req.body.To);
    const profile = await profiles.loadProfile(slug);

    // 1. Compliance keywords FIRST — STOP/HELP/START are law, not features.
    if (profile) {
      const kw = await compliance.processInboundSms(from, body, profile);
      if (kw.handled) return res.send(smsTwiml(kw.reply));
    }

    // 2. Lead capture + activity. upsertLead creates on first contact and
    //    touches last_activity on repeats; it also mirrors into the dashboard
    //    crm.json, replacing the old manual push.
    await crm.upsertLead(slug || DEFAULT_CLIENT_SLUG, {
      phone: from,
      message: body,
      note: body ? body.slice(0, 300) : undefined,
      stage: 'New Lead',
      source: 'sms',
      tags: ['sms'],
    });

    // 3. Same friendly auto-reply as before.
    return res.send(smsTwiml('Thanks for contacting us!'));
  } catch (e) {
    console.error('[sms]', e);
    return res.send(smsTwiml('')); // never 500 at Twilio
  }
});

// ── Social Media Auto-Post Route (via Make.com HTTP webhook) ──
app.post('/social-post', async (req, res) => {
  const { message, imageUrl } = req.body;
  if (!message) return res.status(400).json({ error: 'Message is required' });
  try {
    const payload = imageUrl ? JSON.stringify({ message, imageUrl }) : JSON.stringify({ message });
    const options = {
      hostname: 'hook.us2.make.com',
      path: '/dzmqe5zvxx8t8ew4vtpsvzb9d7d5cz5h',
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(payload) }
    };
    await new Promise((resolve, reject) => {
      const r = https.request(options, resolve);
      r.on('error', reject);
      r.write(payload);
      r.end();
    });
    res.json({ success: true, message: 'Post triggered successfully' });
  } catch (err) {
    console.error('Social post error:', err);
    res.status(500).json({ error: 'Failed to trigger post' });
  }
});

// ── Serve client websites ──
app.use('/sites/:clientId', async (req, res) => {
  const filePath = `/root/newsites-sms/clients/${req.params.clientId}/website/index.html`;
  try {
    await fsp.access(filePath);
    res.sendFile(filePath);
  } catch (_) {
    res.status(404).send('Website not found for this client.');
  }
});

// ── Website generator API ──
