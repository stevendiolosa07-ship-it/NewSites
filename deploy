    if (!message || !clientEmail) return res.status(400).json({ error: 'message and clientEmail required' });

    const id = Date.now().toString();
    await store.updateJson(PENDING_POSTS, [], (posts) => {
      posts.push({ id, message, imageUrl, clientEmail, clientName, createdAt: new Date().toISOString(), status: 'pending' });
    });

    // Stable HTTPS base — nip.io survives restarts; tunnel/IP only as fallback.
    const baseUrl = process.env.PUBLIC_BASE_URL || process.env.TUNNEL_URL || `http://${process.env.VPS_IP || 'localhost'}:3001`;
    const approveUrl = `${baseUrl}/approve-post/${id}`;
    const rejectUrl = `${baseUrl}/reject-post/${id}`;

    const emailHtml = `
      <div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;background:#000;color:#fff;padding:30px;border-radius:10px;">
        <h2 style="color:#FFD700;">NewSites — Post Approval</h2>
        <p>Hi ${clientName || 'there'},</p>
        <p>Your AI has drafted a social media post for your review:</p>
        <div style="background:#111;border:1px solid #FFD700;border-radius:8px;padding:20px;margin:20px 0;">
          <p style="font-size:16px;">${message}</p>
          ${imageUrl ? `<img src="${imageUrl}" style="max-width:100%;border-radius:8px;margin-top:10px;" />` : ''}
        </div>
        <a href="${approveUrl}" style="background:#FFD700;color:#000;padding:14px 28px;text-decoration:none;border-radius:6px;font-weight:bold;display:inline-block;margin-right:10px;">✅ Approve & Post</a>
        <a href="${rejectUrl}" style="background:#333;color:#fff;padding:14px 28px;text-decoration:none;border-radius:6px;font-weight:bold;display:inline-block;">❌ Reject</a>
        <p style="margin-top:30px;color:#888;font-size:12px;">Powered by NewSites.com</p>
      </div>
    `;

    await sgMail.send({
      from: process.env.EMAIL_USER,
      to: clientEmail,
      subject: `📱 Your AI drafted a post — approve it!`,
      html: emailHtml
    });

    res.json({ success: true, message: 'Pending post created and approval email sent', id });
  } catch (e) {
    console.error('Pending post error:', e);
    res.status(500).json({ error: e.message });
  }
});

// Client clicks Approve
app.get('/approve-post/:id', async (req, res) => {
  try {
    let post = null;
    await store.updateJson(PENDING_POSTS, [], (posts) => {
      const p = posts.find((x) => x.id === req.params.id);
      if (p && p.status === 'pending') { p.status = 'approved'; post = p; }
      else if (p) post = { alreadyProcessed: true };
    });
    if (!post) return res.status(404).send('Post not found or already processed.');
    if (post.alreadyProcessed) return res.send('This post has already been processed.');

    const { message, imageUrl } = post;
    const payload = imageUrl ? JSON.stringify({ message, imageUrl }) : JSON.stringify({ message });
    const options = {
      hostname: 'hook.us2.make.com',
      path: '/dzmqe5zvxx8t8ew4vtpsvzb9d7d5cz5h',
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(payload) }
    };
    await new Promise((resolve, reject) => {
      const r = https.request(options, resolve);
      r.on('error', reject);
      r.write(payload);
      r.end();
    });

    res.send(`
      <div style="font-family:Arial,sans-serif;text-align:center;padding:60px;background:#000;color:#FFD700;min-height:100vh;">
        <h1>✅ Post Approved!</h1>
        <p style="color:#fff;">Your post is being published to Instagram now.</p>
      </div>
    `);
  } catch (e) {
    console.error('Approve post error:', e);
    res.status(500).send('Something went wrong approving this post.');
  }
});

// Client clicks Reject
app.get('/reject-post/:id', async (req, res) => {
  try {
    let found = false;
    await store.updateJson(PENDING_POSTS, [], (posts) => {
      const p = posts.find((x) => x.id === req.params.id);
      if (p) { p.status = 'rejected'; found = true; }
    });
    if (!found) return res.status(404).send('Post not found.');
    res.send(`
      <div style="font-family:Arial,sans-serif;text-align:center;padding:60px;background:#000;color:#fff;min-height:100vh;">
        <h1 style="color:#FF4444;">❌ Post Rejected</h1>
        <p>No worries — this post has been discarded.</p>
      </div>
    `);
  } catch (e) {
    res.status(500).send('Something went wrong.');
  }
});

// ── STRIPE CHECKOUT ──
const stripe = require('stripe')(process.env.STRIPE_SECRET_KEY);

const PLANS = {
  starter: { name: 'Starter', amount: 9700, description: 'AI website + monthly updates' },
  growth:  { name: 'Growth',  amount: 29700, description: 'Full AI automation stack' },
  empire:  { name: 'Empire',  amount: 59700, description: 'Full-scale business domination' }
};

app.post('/create-checkout', async (req, res) => {
  try {
    const { plan } = req.body;
    const p = PLANS[plan];
    if (!p) return res.status(400).json({ error: 'Invalid plan' });

    const session = await stripe.checkout.sessions.create({
      payment_method_types: ['card'],
      mode: 'subscription',
      line_items: [{
        price_data: {
          currency: 'usd',
          product_data: { name: `NewSites.com — ${p.name}`, description: p.description },
          unit_amount: p.amount,
          recurring: { interval: 'month' }
        },
        quantity: 1
      }],
      success_url: 'https://stevendiolosa07-ship-it.github.io/NewSites/success.html',
      cancel_url: 'https://stevendiolosa07-ship-it.github.io/NewSites/cancel.html',
    });

    res.json({ url: session.url });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

// ── ONBOARDING → STRIPE CHECKOUT (the live /onboarding — was dead code before dedupe) ──
app.post('/onboarding', async (req, res) => {
  try {
    const { businessName, businessDescription, email, phone, plan } = req.body;
    if (!businessName || !businessDescription || !email) {
      return res.status(400).json({ success: false, error: 'Missing required fields' });
    }
    const PRICE_IDS = {
      starter: process.env.STRIPE_PRICE_STARTER,
      growth: process.env.STRIPE_PRICE_GROWTH,
      empire: process.env.STRIPE_PRICE_EMPIRE
    };
    const priceId = PRICE_IDS[plan] || PRICE_IDS.starter;
    if (!priceId) {
      // STRIPE_PRICE_* not configured yet — fall back to inline pricing so
      // checkout still works instead of 500ing.
      const p = PLANS[plan] || PLANS.starter;
      const session = await stripe.checkout.sessions.create({
        mode: 'subscription',
        payment_method_types: ['card'],
        customer_email: email,
        line_items: [{
          price_data: {
            currency: 'usd',
            product_data: { name: `NewSites.com — ${p.name}`, description: p.description },
            unit_amount: p.amount,
            recurring: { interval: 'month' }
          },
          quantity: 1
        }],
        metadata: {
          business_name: businessName,
          business_description: businessDescription.slice(0, 490),
          phone: phone || '',
          plan: plan || 'starter'
        },
        success_url: 'https://stevendiolosa07-ship-it.github.io/NewSites/social-media-creator.html?paid=true',
        cancel_url: 'https://stevendiolosa07-ship-it.github.io/NewSites/#pricing',
        allow_promotion_codes: true
      });
      return res.json({ success: true, checkoutUrl: session.url });
    }
    const session = await stripe.checkout.sessions.create({
      mode: 'subscription',
      payment_method_types: ['card'],
      customer_email: email,
      line_items: [{ price: priceId, quantity: 1 }],
      metadata: {
        business_name: businessName,
        business_description: businessDescription.slice(0, 490),
        phone: phone || '',
        plan: plan || 'starter'
      },
      success_url: 'https://stevendiolosa07-ship-it.github.io/NewSites/social-media-creator.html?paid=true',
      cancel_url: 'https://stevendiolosa07-ship-it.github.io/NewSites/#pricing',
      allow_promotion_codes: true
    });
    res.json({ success: true, checkoutUrl: session.url });
  } catch (err) {
    console.error('Onboarding error:', err.message);
    res.status(500).json({ success: false, error: err.message });
  }
});

